
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>X/O Match</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #141e30, #243b55);
    color: white;
    text-align: center;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: 95%;
    max-width: 420px;
    padding: 25px;
    background: #ffffff15;
    border-radius: 20px;
    box-shadow: 0 8px 30px #0005;
}

h1 {
    color: #00e5ff;
    font-size: 35px;
}

input, select {
    width: 90%;
    padding: 13px;
    margin: 10px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
}

button {
    padding: 12px 22px;
    margin: 8px;
    border: none;
    border-radius: 8px;
    background: #00c8ff;
    color: #102030;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #00ffcc;
}

#game {
    display: none;
}

.board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 20px auto;
    width: 100%;
    max-width: 330px;
}

.cell {
    aspect-ratio: 1;
    background: #ffffff20;
    border: 2px solid #00d9ff;
    border-radius: 12px;
    font-size: 48px;
    font-weight: bold;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.cell:active {
    background: #ffffff40;
}

#status {
    font-size: 20px;
    margin: 15px;
    min-height: 28px;
    color: #00ffcc;
}

#result {
    font-size: 24px;
    color: #ffe66d;
    font-weight: bold;
}
</style>
</head>

<body>

<div class="container">

    <div id="home">
        <h1>❌ X / O ⭕</h1>
        <h2>Match Game</h2>

        <input id="player1" placeholder="Enter Player 1 Name">
        <input id="player2" placeholder="Enter Player 2 Name">

        <p>Player 1 Select Symbol</p>
        <select id="symbol">
            <option value="X">X</option>
            <option value="O">O</option>
        </select>

        <br>
        <button onclick="startGame()">START GAME</button>
    </div>

    <div id="game">
        <h1>❌ X / O ⭕</h1>

        <h3 id="players"></h3>
        <div id="status">Player 1 Turn</div>

        <div class="board" id="board">
            <div class="cell" onclick="play(0)"></div>
            <div class="cell" onclick="play(1)"></div>
            <div class="cell" onclick="play(2)"></div>
            <div class="cell" onclick="play(3)"></div>
            <div class="cell" onclick="play(4)"></div>
            <div class="cell" onclick="play(5)"></div>
            <div class="cell" onclick="play(6)"></div>
            <div class="cell" onclick="play(7)"></div>
            <div class="cell" onclick="play(8)"></div>
        </div>

        <div id="result"></div>

        <button onclick="restart()">RESTART</button>
        <button onclick="goHome()">HOME</button>
    </div>

</div>

<script>
let board = ["","","","","","","","",""];
let currentPlayer = 0;
let gameOver = false;

let names = ["Player 1", "Player 2"];
let symbols = ["X", "O"];

const winningPatterns = [
    [0,1,2],
    [3,4,5],
    [6,7,8],
    [0,3,6],
    [1,4,7],
    [2,5,8],
    [0,4,8],
    [2,4,6]
];

function startGame() {
    names[0] = document.getElementById("player1").value.trim() || "Player 1";
    names[1] = document.getElementById("player2").value.trim() || "Player 2";

    symbols[0] = document.getElementById("symbol").value;
    symbols[1] = symbols[0] === "X" ? "O" : "X";

    document.getElementById("home").style.display = "none";
    document.getElementById("game").style.display = "block";

    document.getElementById("players").innerText =
        names[0] + " (" + symbols[0] + ")  VS  " +
        names[1] + " (" + symbols[1] + ")";

    restart();
}

function play(index) {
    if (gameOver || board[index] !== "") return;

    board[index] = symbols[currentPlayer];

    document.querySelectorAll(".cell")[index].innerText =
        symbols[currentPlayer];

    if (checkWinner()) {
        document.getElementById("result").innerText =
            "🏆 " + names[currentPlayer] + " Wins!";
        document.getElementById("status").innerText = "Game Over!";
        gameOver = true;
        return;
    }

    if (board.every(cell => cell !== "")) {
        document.getElementById("result").innerText = "🤝 Match Draw!";
        document.getElementById("status").innerText = "Game Over!";
        gameOver = true;
        return;
    }

    currentPlayer = 1 - currentPlayer;

    document.getElementById("status").innerText =
        names[currentPlayer] + "'s Turn (" +
        symbols[currentPlayer] + ")";
}

function checkWinner() {
    return winningPatterns.some(pattern =>
        pattern.every(index => board[index] === symbols[currentPlayer])
    );
}

function restart() {
    board = ["","","","","","","","",""];
    currentPlayer = 0;
    gameOver = false;

    document.querySelectorAll(".cell").forEach(cell => {
        cell.innerText = "";
    });

    document.getElementById("result").innerText = "";

    document.getElementById("status").innerText =
        names[0] + "'s Turn (" + symbols[0] + ")";
}

function goHome() {
    document.getElementById("game").style.display = "none";
    document.getElementById("home").style.display = "block";
    restart();
}
</script>

</body>
</html>
